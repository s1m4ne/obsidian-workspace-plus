{
    "name": "obsidian-workspace-plus",
    "version": "0.8.0",
    "description": "Workspace session manager for Obsidian",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "node esbuild.config.mjs production",
        "check:i18n": "node scripts/check-i18n.js",
        "test": "node --test \"tests/**/*.test.{js,ts}\"",
        "lint": "eslint src scripts tests",
        "lint:fix": "eslint src scripts tests --fix",
        "typecheck": "tsc --noEmit",
        "check": "npm run typecheck && npm run lint:ratchet && npm run check:imports && npm test && npm run coverage && npm run build",
        "lint:ratchet": "node scripts/lint-ratchet.js",
        "coverage": "node scripts/coverage-ratchet.js",
        "check:imports": "node scripts/check-import-extensions.js",
        "progress": "node scripts/progress.js"
    },
    "devDependencies": {
        "@types/jsdom": "^30.0.0",
        "@types/node": "^26.4.0",
        "esbuild": "^0.24.0",
        "eslint": "^9.39.5",
        "eslint-plugin-obsidianmd": "^0.4.2",
        "jsdom": "^30.0.1",
        "obsidian": "^1.13.1",
        "typescript": "~5.9",
        "typescript-eslint": "^8.68.0"
    }
}
